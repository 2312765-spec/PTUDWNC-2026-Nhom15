# Copy thành .env.local (đã nằm trong .gitignore)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: URL API mà server Next.js gọi (authorize() của Auth.js).
# Bỏ trống thì dùng NEXT_PUBLIC_API_URL. Trong Docker: http://api:8080/api/v1
API_INTERNAL_URL=

# Auth.js v5 — BẮT BUỘC. Sinh bằng: npx auth secret   (hoặc: openssl rand -base64 32)
AUTH_SECRET=
# Đặt true khi chạy sau Nginx / trong container
# AUTH_TRUST_HOST=true

# TODO(S9 — A): Google OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
