# CONS-009 — biến môi trường cho docker-compose.prod.yml.
#   cp .env.production.example .env.production   →  điền giá trị  →  KHÔNG commit (.gitignore, NFR-SEC-007)
# Sinh secret ngẫu nhiên:  openssl rand -base64 48

# Domain của site, không có https://. Demo local: culinary.localhost (trình duyệt tự trỏ *.localhost về máy mình).
SITE_DOMAIN=culinary.localhost

POSTGRES_DB=culinaryblog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=

# ≥ 32 ký tự ngẫu nhiên. KHÔNG dùng lại khóa cũ từng nằm trong appsettings.json (đã lộ trong lịch sử Git).
JWT_KEY=

# Khóa S3 (RustFS — D66). Giữ tên MINIO_* để .env.production cũ dùng được luôn.
MINIO_ROOT_USER=culinary-minio
MINIO_ROOT_PASSWORD=

# Auth.js (frontend)
AUTH_SECRET=
# Google OAuth (FR-AUTH-003) — để trống nếu chưa dùng. API dùng chung AUTH_GOOGLE_ID làm Google:ClientId.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Welcome email (FR-JOB-001). Để trống SMTP_HOST thì job gửi mail lỗi và Hangfire retry.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=no-reply@culinaryblog.local

# OpenTelemetry Collector (D36) — để trống thì không export trace/metric.
OTEL_EXPORTER_OTLP_ENDPOINT=

BACKUP_RETENTION_DAYS=30

# Ghi đè image S3 nếu dùng registry riêng (mặc định rustfs/rustfs:1.0.3 — D66).
# S3_IMAGE=registry.example.com/rustfs/rustfs:1.0.3
