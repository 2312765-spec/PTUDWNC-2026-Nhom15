# Copy thành .env (đã nằm trong .gitignore). Dùng cho docker compose.
# NFR-SEC-007: KHÔNG commit file .env thật.

POSTGRES_DB=culinaryblog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Backend — dev dùng .NET User Secrets thay vì file này:
#   cd backend/CulinaryBlog.API
#   dotnet user-secrets set "Jwt:Key" "<chuỗi ngẫu nhiên >= 32 ký tự>"
#   dotnet user-secrets set "Google:ClientId" "<...>"
